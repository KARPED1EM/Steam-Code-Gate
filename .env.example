# Database Configuration / 数据库配置
# Path to the SQLite database file / SQLite 数据库文件路径
# Example / 示例: /data/scg.db
DATABASE_PATH=/data/scg.db

# JWT Security Configuration / JWT 安全配置
# Secret key for JWT token signing (CHANGE THIS IN PRODUCTION!) / JWT 令牌签名密钥（生产环境请务必修改！）
# Generate a secure random key using: openssl rand -hex 32 / 使用以下命令生成安全密钥：openssl rand -hex 32
JWT_SECRET_KEY=your-secret-key-change-this-in-production

# Environment Mode / 运行环境模式 (Optional / 可选)
# Set to "development" to enable hot reload (auto-restart on code changes) / 设置为 "development" 启用热重载（代码变更时自动重启）
# Leave empty or omit for production mode (better performance) / 留空或不设置则为生产模式（性能更好）
# ENVIRONMENT=development
